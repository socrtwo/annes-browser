{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/socrtwo/annes-browser/schema/catalog.schema.json",
  "title": "Anne's Browser compiled catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commands", "layouts", "keymaps"],
  "properties": {
    "version": { "const": 1 },
    "commands": { "type": "array", "items": { "$ref": "#/definitions/command" } },
    "layouts": { "type": "array", "items": { "$ref": "#/definitions/layout" } },
    "keymaps": { "type": "array", "items": { "$ref": "#/definitions/keymap" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 64 },
    "commandId": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$", "maxLength": 80 },
    "text": { "type": "string", "minLength": 1, "maxLength": 300 },
    "when": { "type": "string", "minLength": 1, "maxLength": 512 },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "description", "status", "phase", "platforms"],
      "properties": {
        "id": { "$ref": "#/definitions/commandId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "uniqueItems": true },
        "category": {
          "enum": ["app", "file", "edit", "view", "nav", "tab", "bookmark", "history", "page", "tools", "privacy", "input", "extract", "legacy", "module", "help"]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["browser"],
            "properties": {
              "browser": { "$ref": "#/definitions/text" },
              "versions": { "type": "string", "maxLength": 40 },
              "menu": { "type": "string", "maxLength": 200 },
              "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
              "source": { "enum": ["census", "manual", "screenshot", "recalled"] },
              "key": { "type": "string", "maxLength": 200 },
              "ref": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "status": { "enum": ["implement", "emulate", "stub", "omit"] },
        "status_reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "phase": { "type": "integer", "minimum": 1, "maximum": 10 },
        "platforms": { "type": "array", "items": { "enum": ["desktop", "android"] }, "uniqueItems": true, "minItems": 1 },
        "when": { "$ref": "#/definitions/when" },
        "checked": { "$ref": "#/definitions/when" },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["network", "filesystem", "clipboard", "external-app", "page-script", "history", "credentials"] }
        },
        "args": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "maxLength": 32 },
              "type": { "enum": ["string", "number", "boolean", "url"] },
              "optional": { "type": "boolean" },
              "description": { "type": "string", "maxLength": 200 }
            }
          }
        }
      }
    },
    "layoutItem": {
      "oneOf": [
        { "$ref": "#/definitions/commandId" },
        { "type": "object", "additionalProperties": false, "required": ["separator"], "properties": { "separator": { "const": true } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "items"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 60 },
            "items": { "type": "array", "items": { "$ref": "#/definitions/layoutItem" } }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "menus"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "menus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "items"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "items": { "type": "array", "items": { "$ref": "#/definitions/layoutItem" } }
            }
          }
        }
      }
    },
    "keymap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "bindings"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "extends": { "$ref": "#/definitions/id" },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keys", "command"],
            "properties": {
              "keys": { "type": "string", "minLength": 1, "maxLength": 80 },
              "command": { "type": "string", "pattern": "^(-|[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+)$" },
              "when": { "$ref": "#/definitions/when" },
              "args": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
            }
          }
        }
      }
    }
  }
}
