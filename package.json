{
  "name": "annes-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Anne's Browser: every menu command from 35 years of web browsers, plus new ones.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog": "node tools/build-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run catalog && node tools/build.ts",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node tools/smoke.ts",
    "check": "npm run typecheck && npm run catalog && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "ajv": "8.20.0",
    "electron": "45.5.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  }
}
